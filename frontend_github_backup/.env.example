# Frontend example env for local development (Create React App)
# Optional: when empty, CRA dev server will proxy to http://127.0.0.1:8000 as configured in package.json
# To point to a remote backend, set REACT_APP_API_URL to full origin (include trailing slash if you like):
REACT_APP_API_URL=

# Dev helper token: set this in browser console as `window.__DEV_TOKEN__ = '<JWT>'`
# or store it in localStorage under key `DEV_JWT_TOKEN` or `ea_dev_token`.
# Example: in browser console -> localStorage.setItem('DEV_JWT_TOKEN','<token>')
