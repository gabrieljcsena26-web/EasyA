# Backend example environment variables
# SECRET_KEY must match any tokens you generate locally (keep secret in production)
SECRET_KEY=change-me-dev-secret
# Token lifetime in minutes (e.g., 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS: comma separated allowed origins, default '*' allows all during development
FRONTEND_URLS=http://127.0.0.1:3000
