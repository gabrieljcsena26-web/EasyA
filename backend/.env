# EasyAgenda - EPIC Configuration

# Security
SECRET_KEY=easyagenda-epic-secret-key-change-in-production-xyz789
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database
DATABASE_URL=postgresql://easyagenda_user:easyagenda_pass_secure_2024@localhost:5432/easyagenda

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend URLs (comma-separated)
FRONTEND_URLS=https://schedule-fortress-1.preview.emergentagent.com,http://localhost:3000,http://localhost:5173
BOOKING_PUBLIC_BASE_URL=https://schedule-fortress-1.preview.emergentagent.com
API_PUBLIC_BASE_URL=https://schedule-fortress-1.preview.emergentagent.com

# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# WhatsApp - Meta Cloud API (Graph API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_API_VERSION=v21.0

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@easyagenda.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Google OAuth (Calendar Import)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Trial
TRIAL_DAYS=4

# Workers
ENABLE_WORKERS=true
WORKER_CONCURRENCY=4

# PDF Generation
PDF_LOGO_URL=
PDF_COMPANY_INFO=

# Cloudflare
ALLOWED_HOSTS=*
