# EasyAgenda Backend Environment Variables

# Security
SECRET_KEY=easyagenda-secret-key-change-in-production-12345678
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite for dev - PostgreSQL for production)
# For PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./easyagenda.db

# CORS - Frontend URLs (comma-separated)
FRONTEND_URLS=https://schedule-fortress-1.preview.emergentagent.com,http://localhost:3000,http://localhost:5173
BOOKING_PUBLIC_BASE_URL=https://schedule-fortress-1.preview.emergentagent.com
API_PUBLIC_BASE_URL=https://schedule-fortress-1.preview.emergentagent.com

# Environment
ENV=development
LOG_LEVEL=INFO

# WhatsApp - Meta Cloud API (NOT Twilio)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Email (optional - for fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@easyagenda.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Workers
ENABLE_INLINE_WORKERS=true
DISABLE_NOTIFICATIONS_WORKER=false

# Features
AUTO_CREATE_DB=true
AUTO_DEV_MIGRATIONS=true
ENABLE_DEV_LOGIN=true
DEV_SLUG=dev

# Cloudflare (for production)
ALLOWED_HOSTS=
CORS_ALLOW_ORIGIN_REGEX=
ENABLE_PAGES_DEV_CORS=false
